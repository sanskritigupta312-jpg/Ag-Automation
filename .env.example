# ═══════════════════════════════════════════════════════════════
# Antigravity — Threads Automation Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Chrome DevTools Protocol port
# Chrome must be launched with: chrome.exe --remote-debugging-port=9222
CDP_PORT=9222

# Antigravity Local Gemini Engine URL
# This is the localhost endpoint where your local Gemini model runs
# via the Antigravity framework (default port 11434 for Ollama-style)
GEMINI_LOCAL_HOST=http://localhost:11434

# Local Gemini model name (served by Antigravity)
GEMINI_LOCAL_MODEL=gemini-flash

# Dashboard web server port (open http://localhost:3000 in your browser)
DASHBOARD_PORT=3000

# Initial operational mode when no saved profile is found
# Options: FEED | DM | PROFILE | NOTIFICATIONS
INITIAL_MODE=FEED
